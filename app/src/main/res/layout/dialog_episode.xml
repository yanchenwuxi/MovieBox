<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_dialog_top"
    android:paddingTop="14dp" android:paddingBottom="10dp">

    <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" android:text="选集" android:textSize="16sp"
        android:textStyle="bold" android:textColor="@color/text_main"/>

    <com.google.android.material.tabs.TabLayout android:id="@+id/tabLines"
        android:layout_width="match_parent" android:layout_height="40dp"
        android:layout_marginTop="8dp" app:tabMode="scrollable"
        app:tabIndicatorColor="@color/primary" app:tabIndicatorHeight="2dp"
        app:tabTextColor="@color/text_sub" app:tabSelectedTextColor="@color/primary"
        app:tabMinWidth="0dp" app:tabPaddingStart="14dp" app:tabPaddingEnd="14dp"/>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvEpisodes"
        android:layout_width="match_parent" android:layout_height="340dp" android:padding="6dp"/>
</LinearLayout>
