<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_dialog" android:padding="16dp">

    <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="选择解析线路" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/text_main"/>
    <TextView android:id="@+id/tvMsg" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textSize="12sp" android:textColor="@color/text_sub"
        android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerView"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:maxHeight="420dp"/>

    <TextView android:id="@+id/btnCancel" android:layout_width="match_parent" android:layout_height="42dp"
        android:layout_marginTop="8dp" android:gravity="center" android:text="取消"
        android:textSize="14sp" android:textColor="@color/text_sub" android:background="@drawable/bg_btn_gray"/>
</LinearLayout>
