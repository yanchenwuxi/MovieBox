<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
    android:paddingTop="9dp" android:paddingBottom="9dp"
    android:background="?android:attr/selectableItemBackground">
    <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="14sp" android:textColor="@color/text_main" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/sub" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:textSize="11sp" android:textColor="@color/text_light"
        android:maxLines="1" android:ellipsize="end" android:visibility="gone"/>
</LinearLayout>
